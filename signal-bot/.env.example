# Signal (signal-cli-rest-api)
SIGNAL_SERVICE_URL=http://signal-cli:8080
SIGNAL_PHONE_NUMBER=+91XXXXXXXXXX

# Vaquill API
VAQUILL_API_URL=https://api.vaquill.ai/api/v1
VAQUILL_API_KEY=vq_key_...
VAQUILL_MODE=standard
VAQUILL_COUNTRY_CODE=IN

# Rate limiting
RATE_LIMIT_PER_USER_PER_DAY=100
RATE_LIMIT_PER_USER_PER_MINUTE=5

# Security (comma-separated E.164 phone numbers, empty = allow all)
ALLOWED_USERS=

# Bot behaviour
MAX_MESSAGE_LENGTH=4000
MAX_CONVERSATION_HISTORY=10
MAX_SOURCES_PER_RESPONSE=5

# Observability
LOG_LEVEL=INFO
ENVIRONMENT=production
