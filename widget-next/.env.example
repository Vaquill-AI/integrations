# =============================================
# Vaquill Widget — Environment Variables
# =============================================
# Most config is hardcoded in src/config/constants.ts. The values here
# are either secrets or knobs you'd realistically flip without a code
# change (mode, jurisdiction, source count, embed style).
# =============================================

# Required: your Vaquill API key (starts with vq_key_)
# Get one at https://app.vaquill.ai/developer
VAQUILL_API_KEY=vq_key_...

# RAG mode: `standard` (default, faster) | `deep` (more thorough, costs more credits).
# Server-enforced — clients can't override it.
VAQUILL_MODE=standard

# Jurisdiction: `US` (default) | `IN` (Indian law).
VAQUILL_COUNTRY_CODE=US

# Number of source citations to show per answer (1–30, default 5).
VAQUILL_MAX_SOURCES=5

# Embed style — controls what `/` renders for direct visitors:
#   `inline`   (default): full-page chat. Customers iframe `/` to embed it.
#   `floating`          : tiny landing that auto-injects the floating
#                         chat bubble. Customers paste the
#                         `<script src="…/embed.js">` snippet on their
#                         own site to get the same behavior.
# Either way, the iframe loaded by embed.js carries `?embed=1` and
# always shows the chat — no recursion.
VAQUILL_EMBED_MODE=inline
